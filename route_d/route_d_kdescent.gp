/* Exact 2-descent over a real quadratic field K, for a curve with full 2-torsion over K,
   plus the three 2-isogeny descents.  Used to prove rank 0 for the twists E3^(al ga delta3) and
   E4^(be ga delta4) of Theorem weilres (route_d_weilres_rank0.gp), where Simon's descent in
   Sage gives only weak, model-dependent bounds.

   E: y^2 = (x - e1)(x - e2)(x - e3), e_i in K.  K(S,2) = O_S^* / O_S^*2 with S enlarged until
   the S-class group is odd (so K(S,2) is generated by -1, the fundamental unit and the S-units).

   Local square classes at a place v (sqclass):
     real v: the sign;  finite v above p: (v(d) mod 2, class of the unit part u), where u is a
     square in K_v iff it is a square mod v^k, k = 1 for odd p and k = 2e+1 for p = 2 (Hensel:
     u = w^2 (1 + 4 pi z) and 1 + 4 pi z is a square).  The class is ideallog(u) mod 2 on the
     even cyclic factors of (O / v^k)^*.
   Local images at finite v are sampled from points of E(K_v) until they reach their exact size
   (at real v they are read off the components of E(R)):
     full descent:  |E(K_v)/2E(K_v)| = 4 * 2^[K_v:Q_2] (finite v), 2 (real v; all e_i real);
     isogeny phi with kernel T, alpha(P) = x(P) - x(T):  |im alpha_v| * |im alpha'_v| equals the
     same number, since all 2-torsion is rational (E'[phi^]/phi(E[2]) = 0).
   Sampled images can only be too small, so reaching the size certifies them.

   Bounds:  rank E(K) <= dim Sel2(E) - 2,   rank E(K) <= dim Sel_phi + dim Sel_phi' - 2.
   The class group comes from bnfinit (GRH); kcertify() removes that assumption.

   kdescent(s, e) -> [dim Sel2 - 2, [isogeny bounds], details]   (s: K = Q(sqrt s), e: polmods)
   kfibre(a, b, al, be, ga): both twists of a fibre, with root number.
   An isogeny descent whose local images cannot be completed by sampling (E' with 2-torsion roots
   in K_v but not in K) is reported as "n/a"; the full-descent bound is unaffected.

   Validation (2026-10-05): on E_{a,b} over K (rank = rank E(Q) + rank E^sigma(Q) by ellrank) for
   5:3, 7:1, 13:5, 17:7, 43:9, 11:3 no bound is below the rank, and 4 of 6 are sharp. On all 48
   twists of the 10 unresolved lines the parity of the Sel2 bound equals the root number.
   11:3 (65,2,1): bound 2 for both twists (rank 0 by the L-value, so Sha[2] = (Z/2)^2).
   81:19 (2,3461,1) and (3461,2,1), E3: bound 0, so rank 0 (class group of Q(sqrt 6922)
   certified). Root-number-+1 twists elsewhere: bound 2 (79:45, 81:59, 83:55) or 4. */

/* ---------- K(S,2) ---------- */
kS2(bnf, PS) =
{
  my(ps = Set(PS), U, p = 2);
  for(it = 1, 60,
    U = bnfsunit(bnf, concat(apply(q -> idealprimedec(bnf, q), ps)));
    if(U[5][1] % 2, break);
    while(setsearch(ps, p), p = nextprime(p + 1));
    ps = setunion(ps, [p]));
  if(U[5][1] % 2 == 0, error("kS2: S-class group stays even"));
  my(md = bnf.pol, G = concat([Mod(lift(bnf.tu[2]), md)], apply(u -> Mod(lift(u), md), bnf.fu)));
  G = concat(G, apply(u -> Mod(lift(u), md), U[1]));
  [G, ps];
}

/* ---------- places and square classes ---------- */
kplaces(nf, PS) =
{
  my(L = List());
  for(i = 1, nf.r1, listput(L, [0, i]));
  foreach(PS, p, foreach(idealprimedec(nf, p), pr,
    my(pi = nfbasistoalg(nf, pr[2]));
    if(nfeltval(nf, pi, pr) != 1, pi = p);
    if(nfeltval(nf, pi, pr) != 1, error("kplaces: no uniformizer"));
    my(k = if(p == 2, 2*pr[3] + 1, 1), bid = idealstar(nf, idealpow(nf, pr, k), 1));
    my(P = [pr, bid, pi, if(p == 2, pr[3]*pr[4], 0)], nev = #[c | c <- bid.cyc, c % 2 == 0]);
    if(1 + nev != sqdim(P), error("kplaces: dim K_v*/K_v*^2 = ", 1 + nev, " != ", sqdim(P)));
    listput(L, P)));
  Vec(L);
}

sqclass(nf, P, d) =
{
  if(d == 0, error("sqclass: zero"));
  if(P[1] == 0, return([(1 - nfeltsign(nf, d, P[2])) / 2]~));
  my(v = nfeltval(nf, d, P[1]), u = d / P[3]^v, L = ideallog(nf, u, P[2]), cyc = P[2].cyc, out = List([v % 2]));
  for(i = 1, #cyc, if(cyc[i] % 2 == 0, listput(out, L[i] % 2)));
  Col(Vec(out));
}

/* dimension of K_v^* / K_v^*2 */
sqdim(P) = if(P[1] == 0, 1, 2 + P[4]);

/* expected size exponent of E(K_v)/2E(K_v) */
e2dim(P) = if(P[1] == 0, 1, 2 + P[4]);

f2rank(V) = if(#V == 0, 0, matrank(Mod(Mat(V), 2)));

/* annihilator rows (as a matrix) of the span of the columns V inside F2^n */
annih(V, n) = { my(M = if(#V, Mat(V), matrix(n, 0))); my(K = matker(Mod(M~, 2))); if(#K == 0, matrix(0, n), lift(K)~); }

/* sample x in K near the e_i and near infinity, at place P */
ksample(nf, P, e, k, t0, t1) =
{
  my(base = if(P[1] == 0, 2, P[3]), w = nfbasistoalg(nf, [0, 1]~));
  e + base^k * (t0 + t1*w);
}

/* ---------- real places: the image is fixed by the components of E(R) ----------
   g: monic cubic in 'x over K; cls: real x -> F2 class vector.  One sample point inside each
   component of {g >= 0}; the class map is constant on components. */
embed(nf, z, i) = if(type(z) == "t_POLMOD", subst(lift(z), 'y, nf.roots[i]), z);
realimage(nf, i, g, cls) =
{
  my(gr = sum(k = 0, 3, embed(nf, polcoeff(g, k, 'x), i) * 'x^k), R = vecsort(real(select(z -> abs(imag(z)) < 1e-30, polroots(gr)))));
  my(pts = if(#R == 3, [(R[1] + R[2])/2, R[3] + 1], [R[1] + 1]));
  apply(cls, pts);
}

/* ---------- full 2-descent ---------- */
fulllocal(nf, P, e) =
{
  if(P[1] == 0, my(i = P[2], er = apply(z -> embed(nf, z, i), e));
    return(realimage(nf, i, ('x - e[1])*('x - e[2])*('x - e[3]), xr -> [xr < er[1], xr < er[2]]~)));
  my(f = x -> (x - e[1])*(x - e[2])*(x - e[3]), del = x -> concat(sqclass(nf, P, x - e[1]), sqclass(nf, P, x - e[2])));
  my(imgs = List([concat(sqclass(nf, P, (e[1] - e[2])*(e[1] - e[3])), sqclass(nf, P, e[1] - e[2])),
                  concat(sqclass(nf, P, e[2] - e[1]), sqclass(nf, P, (e[2] - e[1])*(e[2] - e[3]))),
                  concat(sqclass(nf, P, e[3] - e[1]), sqclass(nf, P, e[3] - e[2]))]));
  my(target = e2dim(P), n = 2*sqdim(P));
  if(f2rank(Vec(imgs)) >= target, return(Vec(imgs)));
  for(T = 1, 12, for(k = -6, 9, foreach(e, ei, for(t0 = -T, T, for(t1 = -T, T,
    if(max(abs(t0), abs(t1)) < T, next);
    my(x = ksample(nf, P, ei, k, t0, t1), fx = f(x));
    if(fx == 0, next);
    my(c = sqclass(nf, P, fx));
    if(c == 0*c,
      listput(imgs, del(x));
      if(f2rank(Vec(imgs)) >= target, return(Vec(imgs)))))))));
  error("fulllocal: stuck below dim ", target, " at ", P[1]);
}

/* ---------- isogeny descent: E: y^2 = x(x^2 + a x + b), alpha(P) = x mod squares ---------- */
alphalocal(nf, P, a, b, imgs, T, centers) =
{
  my(f = x -> x*(x^2 + a*x + b));
  foreach(centers, z, for(k = -6, 9, for(t0 = -T, T, for(t1 = -T, T,
    if(max(abs(t0), abs(t1)) < T, next);
    my(x = ksample(nf, P, z, k, t0, t1), fx = f(x));
    if(fx == 0, next);
    my(c = sqclass(nf, P, fx));
    if(c == c*0, listput(imgs, sqclass(nf, P, x)))))));
  imgs;
}

isolocal(nf, P, a, b) =
{
  my(a2 = -2*a, b2 = a^2 - 4*b, target = e2dim(P));
  if(P[1] == 0,
    my(W1 = realimage(nf, P[2], 'x*('x^2 + a*'x + b), xr -> [xr < 0]~), W2 = realimage(nf, P[2], 'x*('x^2 + a2*'x + b2), xr -> [xr < 0]~));
    if(f2rank(W1) + f2rank(W2) != target, error("isolocal: real dims ", [f2rank(W1), f2rank(W2)]));
    return([W1, W2]));
  /* images of the 2-torsion: x = 0 -> b; the roots r of x^2 + a x + b need not be in K for E' */
  my(I1 = List([sqclass(nf, P, b)]), I2 = List([sqclass(nf, P, b2)]));
  my(r = apply(z -> Mod(z, nf.pol), nfroots(nf, 'x^2 + lift(a)*'x + lift(b))));
  my(r2 = apply(z -> Mod(z, nf.pol), nfroots(nf, 'x^2 + lift(a2)*'x + lift(b2))));
  foreach(r, ri, listput(I1, sqclass(nf, P, ri)));
  foreach(r2, ri, listput(I2, sqclass(nf, P, ri)));
  my(c1 = concat([0], r), c2 = concat([0], r2));
  for(T = 1, 12,
    if(f2rank(Vec(I1)) + f2rank(Vec(I2)) >= target, break);
    I1 = alphalocal(nf, P, a, b, I1, T, c1);
    I2 = alphalocal(nf, P, a2, b2, I2, T, c2));
  my(d1 = f2rank(Vec(I1)), d2 = f2rank(Vec(I2)));
  if(d1 + d2 != target, error("isolocal: dims ", [d1, d2], " != ", target, " at ", P[1]));
  [Vec(I1), Vec(I2)];
}

/* ---------- Selmer groups ---------- */
/* dim of {c in F2^m : for each place, (sum c_j loc(g_j)) in W_P}, loc vectors of length n_P */
seldim(nf, places, G, imgsets, blocks) =
{
  my(m = #G, rows = List());
  for(i = 1, #places, my(P = places[i], n = sqdim(P), W = imgsets[i]);
    my(A = annih(W, blocks*n));
    if(matsize(A)[1] == 0, next);
    my(Lam = matrix(blocks*n, blocks*m));
    for(j = 1, m, my(c = sqclass(nf, P, G[j]));
      for(bk = 0, blocks - 1, for(r = 1, n, Lam[bk*n + r, bk*m + j] = c[r])));
    my(R = A * Lam);
    for(r = 1, #R[, 1], listput(rows, R[r, ])));
  if(#rows == 0, return(blocks*m));
  blocks*m - matrank(Mod(matconcat(Col(Vec(rows))), 2));
}

kdescent(s, e) =
{
  my(bnf = bnfinit('y^2 - s, 1), nf = bnf.nf);
  e = apply(z -> Mod(lift(z), nf.pol), e);
  my(dis = [e[1] - e[2], e[1] - e[3], e[2] - e[3]], PS = [2]);
  foreach(dis, d, my(N = norm(d)); PS = concat(PS, factor(numerator(N))[, 1]~); PS = concat(PS, factor(denominator(N))[, 1]~));
  foreach(e, ei, if(ei != 0, my(N = norm(ei)); PS = concat(PS, factor(numerator(N))[, 1]~); PS = concat(PS, factor(denominator(N))[, 1]~)));
  PS = Set([p | p <- PS, p > 1]);
  my(KS = kS2(bnf, PS), G = KS[1], places = kplaces(nf, KS[2]));
  /* full descent */
  my(full = vector(#places, i, fulllocal(nf, places[i], e)));
  my(s2 = seldim(nf, places, G, full, 2));
  /* three isogenies */
  my(iso = vector(3, i, my(j = (i % 3) + 1, k = ((i + 1) % 3) + 1, a = -((e[j] - e[i]) + (e[k] - e[i])), b = (e[j] - e[i])*(e[k] - e[i]));
    iferr(my(loc = vector(#places, t, isolocal(nf, places[t], a, b)));
      my(s1 = seldim(nf, places, G, vector(#places, t, loc[t][1]), 1), s1p = seldim(nf, places, G, vector(#places, t, loc[t][2]), 1));
      [s1, s1p, s1 + s1p - 2], err, [-1, -1, "n/a"])));
  [s2 - 2, vector(3, i, iso[i][3]), [#G, #places, KS[2], s2, iso]];
}

/* twists of Theorem weilres as e-triples: E^(d): X(X^2 + d lam X + d^2 mu), roots 0 and d r */
wre(a, b, al, be, ga, which) =
{
  my(s = a^2 + b^2, r = Mod('y, 'y^2 - s));
  if(which == 3, my(d = al*ga*(-2*a*(a + r))); [0, d*2*b*s*(b + r), d*2*b*s*(b - r)],
                 my(d = be*ga*(2*b*(r - b))); [0, d*2*a*s*(a + r), d*2*a*s*(a - r)]);
}

kcertify(s) = bnfcertify(bnfinit('y^2 - s, 1));

/* both twists of a fibre: root number and the descent bounds */
kfibre(a, b, al, be, ga) =
{
  my(s = a^2 + b^2);
  foreach([3, 4], w, my(t = getabstime(), e = wre(a, b, al, be, ga, w));
    my(nf = nfinit('y^2 - s), E = ellinit([0, -(e[2] + e[3]), 0, e[2]*e[3], 0], nf));
    my(r = iferr(kdescent(s, e), err, [Str(err), [], []]));
    print(a, ":", b, " (", al, ",", be, ",", ga, ") E", w, "  rootno ", ellrootno(E), "  Sel2 bound ", r[1],
          "  isogeny bounds ", r[2], "  [#K(S,2), #places, dim Sel2, Sel_phi dims] ",
          if(#r[3], [r[3][1], r[3][2], r[3][4], apply(v -> v[1..2], r[3][5])], []), "  (", (getabstime() - t) \ 1000, " s)"));
}
